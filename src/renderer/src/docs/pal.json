{
  "schema_version": 4,
  "game": {
    "id": "palworld",
    "name": "Palworld",
    "engine": "ue5",
    "binary_path": "${win64_dir}\\Palworld-Win64-Shipping.exe",
    "domain_name": "palworld",
    "display_name": "幻兽帕鲁"
  },
  "setup": {
    "default_dependencies": [
      {
        "id": "palworld_re_ue4ss",
        "name": "RE-UE4SS for Palworld",
        "type": "loader",
        "notes": "安装模组前必须先下载并安装此默认依赖",
        "source": "github_release",
        "install": {
          "target": {
            "path": "${win64_dir}",
            "type": "game_relative",
            "append_package_dir": false
          },
          "install_rules": [
            {
              "id": "palworld_re_ue4ss_root",
              "name": "RE-UE4SS for Palworld",
              "priority": 900,
              "confidence": 95,
              "match": {
                "all_file_patterns": ["**/dwmapi.dll", "**/ue4ss/UE4SS.dll"]
              },
              "source": {
                "type": "folder_containing",
                "marker": "dwmapi.dll",
                "preserve_candidate_dir": false
              },
              "target": {
                "path": "${win64_dir}",
                "type": "game_relative",
                "append_package_dir": false
              }
            },
            {
              "id": "palworld_re_ue4ss_dwmapi_fallback",
              "name": "RE-UE4SS for Palworld fallback",
              "priority": 890,
              "confidence": 90,
              "match": {
                "any_file_patterns": ["**/dwmapi.dll"]
              },
              "source": {
                "type": "folder_containing",
                "marker": "dwmapi.dll",
                "preserve_candidate_dir": false
              },
              "target": {
                "path": "${win64_dir}",
                "type": "game_relative",
                "append_package_dir": false
              }
            }
          ]
        },
        "blocking": true,
        "provider": {
          "tag": "experimental-palworld",
          "repo": "RE-UE4SS",
          "owner": "Okaetsu",
          "asset_name": "UE4SS-Palworld.zip"
        },
        "required": true
      }
    ]
  },
  "variables": {
    "game_dir": "Pal",
    "paks_dir": "${game_dir}\\Content\\Paks",
    "win64_dir": "${game_dir}\\Binaries\\Win64",
    "pak_mods_dir": "${game_dir}\\Content\\Paks\\~mods",
    "legacy_ue4ss_mods_dir": "${win64_dir}\\Mods",
    "ue4ss_mods_dir": "${win64_dir}\\ue4ss\\Mods",
    "user_config_dir": "${game_dir}\\Saved\\Config\\Windows",
    "palschema_mods_dir": "${ue4ss_mods_dir}\\PalSchema\\mods"
  },
  "game_detect": {
    "select": {
      "strategy": "highest_confidence"
    },
    "candidates": [
      {
        "name": "palworld_steam",
        "type": "exe_search",
        "markers": {
          "all_files": [
            "Palworld.exe",
            "${win64_dir}\\Palworld-Win64-Shipping.exe"
          ]
        },
        "root_from": {
          "up": 0,
          "type": "exe_dir"
        },
        "confidence": 100
      },
      {
        "name": "palworld_gamepass",
        "type": "exe_search",
        "markers": {
          "all_files": [
            "Palworld-WinGDK-Shipping.exe"
          ]
        },
        "root_from": {
          "up": 3,
          "type": "exe_dir"
        },
        "confidence": 90
      }
    ]
  },
  "install_rules": [
    {
      "id": "palworld_mixed_package",
      "name": "Palworld 混合包",
      "priority": 800,
      "confidence": 95,
      "match": {
        "any_of": [
          { "any_file_patterns": ["**/*.pak", "**/*.ucas", "**/*.utoc"] },
          { "any_dir_patterns": ["${legacy_ue4ss_mods_dir}\\*", "${paks_dir}\\LogicMods", "Binaries\\Win64\\Mods\\*", "Content\\Paks\\LogicMods"] }
        ]
      },
      "routes": [
        {
          "id": "pal_logicmods_files",
          "source": {
            "include": [
              "${paks_dir}\\LogicMods\\**\\*.pak",
              "${paks_dir}\\LogicMods\\**\\*.ucas",
              "${paks_dir}\\LogicMods\\**\\*.utoc"
            ]
          },
          "target": {
            "type": "game_relative",
            "path": "${paks_dir}\\LogicMods"
          },
          "mapping": {
            "strip_prefix": "${paks_dir}\\LogicMods"
          },
          "group": {
            "type": "unreal_pak",
            "require_siblings": false
          }
        },
        {
          "id": "pal_logicmods_files_unwrapped",
          "source": {
            "include": [
              "Content\\Paks\\LogicMods\\**\\*.pak",
              "Content\\Paks\\LogicMods\\**\\*.ucas",
              "Content\\Paks\\LogicMods\\**\\*.utoc"
            ]
          },
          "target": {
            "type": "game_relative",
            "path": "${paks_dir}\\LogicMods"
          },
          "mapping": {
            "strip_prefix": "Content\\Paks\\LogicMods"
          },
          "group": {
            "type": "unreal_pak",
            "require_siblings": false
          }
        },
        {
          "id": "pal_legacy_ue4ss_mods",
          "name": "旧 UE4SS Mods 路径转发",
          "description": "将压缩包内旧脚本目录转发到 ue4ss\\Mods，保留模组容器目录。",
          "source": {
            "include": ["${legacy_ue4ss_mods_dir}\\**"]
          },
          "target": {
            "type": "game_relative",
            "path": "${ue4ss_mods_dir}"
          },
          "mapping": {
            "strip_prefix": "${legacy_ue4ss_mods_dir}",
            "preserve_container": true
          },
          "health_expectations": {
            "required_dirs": ["${ue4ss_mods_dir}"]
          }
        },
        {
          "id": "pal_legacy_ue4ss_mods_unwrapped",
          "name": "旧 UE4SS Mods 路径转发（无 Pal 前缀）",
          "description": "兼容压缩包直接从 Binaries\\Win64 开始的旧脚本目录结构。",
          "source": {
            "include": ["Binaries\\Win64\\Mods\\**"]
          },
          "target": {
            "type": "game_relative",
            "path": "${ue4ss_mods_dir}"
          },
          "mapping": {
            "strip_prefix": "Binaries\\Win64\\Mods",
            "preserve_container": true
          },
          "health_expectations": {
            "required_dirs": ["${ue4ss_mods_dir}"]
          }
        },
        {
          "id": "pal_pak_files",
          "source": {
            "include": ["**/*.pak", "**/*.ucas", "**/*.utoc"]
          },
          "target": {
            "type": "game_relative",
            "path": "${pak_mods_dir}"
          },
          "mapping": {
            "flatten": false
          },
          "group": {
            "type": "unreal_pak",
            "require_siblings": false
          }
        }
      ],
      "coverage_policy": {
        "unmatched": "warn"
      },
      "description": "同时处理 Palworld Pak/IoStore 文件、LogicMods 目录和旧 UE4SS Mods 目录；旧脚本目录统一转发到 ue4ss\\Mods。"
    },
    {
      "id": "pal_runnable_tool_payload",
      "name": "Palworld 可运行工具包",
      "priority": 610,
      "match": {
        "any_file_patterns": ["*.exe"]
      },
      "source": {
        "type": "package_root"
      },
      "target": {
        "path": "Mod\\Palworld\\Runnable",
        "type": "download_relative",
        "usage_type": 2,
        "mark_runnable": true
      },
      "description": "根目录包含顶层 exe 文件时，识别为可运行工具并安装到下载目录。"
    },
    {
      "id": "pal_root_structure",
      "name": "标准根目录结构",
      "priority": 600,
      "match": {
        "root_has_dirs": ["${game_dir}"],
        "none_file_patterns": [
          "${legacy_ue4ss_mods_dir}\\**",
          "${game_dir}\\Content\\Paks\\LogicMods\\**"
        ],
        "none_dir_patterns": [
          "${legacy_ue4ss_mods_dir}",
          "${legacy_ue4ss_mods_dir}\\*",
          "${legacy_ue4ss_mods_dir}\\**",
          "${game_dir}\\Content\\Paks\\LogicMods"
        ]
      },
      "source": {
        "type": "package_root"
      },
      "target": {
        "path": ".",
        "type": "game_root"
      },
      "description": "具有完整游戏目录结构的模组优先级最高。"
    },
    {
      "id": "pal_root_structure_game_relative",
      "name": "标准 Pal 目录结构直装",
      "priority": 599,
      "match": {
        "root_has_dirs": ["${game_dir}"],
        "none_file_patterns": [
          "${legacy_ue4ss_mods_dir}\\**",
          "${game_dir}\\Content\\Paks\\LogicMods\\**"
        ],
        "none_dir_patterns": [
          "${legacy_ue4ss_mods_dir}",
          "${legacy_ue4ss_mods_dir}\\*",
          "${legacy_ue4ss_mods_dir}\\**",
          "${game_dir}\\Content\\Paks\\LogicMods"
        ]
      },
      "source": {
        "type": "package_root"
      },
      "target": {
        "path": ".",
        "type": "game_relative"
      },
      "description": "兼容旧安装引擎：完整 Pal 目录结构直接安装到游戏根，避免被基础 Pak 兜底规则拆成单文件安装。"
    },
    {
      "id": "pal_schema_submod_payload_raw",
      "name": "PalSchema 数据扩展模组（raw）",
      "priority": 595,
      "match": {
        "root_has_dirs": ["raw"],
        "root_has_files": ["metadata.json"]
      },
      "source": {
        "type": "package_root",
        "preserve_candidate_dir": true
      },
      "target": {
        "path": "${palschema_mods_dir}",
        "type": "game_relative"
      },
      "description": "根目录命中 raw 目录时，识别为 PalSchema 数据扩展模组。",
      "post_install": [
        { "path": "${palschema_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "pal_schema_submod_payload_blueprints",
      "name": "PalSchema 数据扩展模组（blueprints）",
      "priority": 594,
      "match": {
        "root_has_dirs": ["blueprints"],
        "root_has_files": ["metadata.json"]
      },
      "source": {
        "type": "package_root",
        "preserve_candidate_dir": true
      },
      "target": {
        "path": "${palschema_mods_dir}",
        "type": "game_relative"
      },
      "description": "根目录命中 blueprints 目录时，识别为 PalSchema 数据扩展模组。",
      "post_install": [
        { "path": "${palschema_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "pal_schema_submod_payload_pals",
      "name": "PalSchema 数据扩展模组（pals）",
      "priority": 593,
      "match": {
        "root_has_dirs": ["pals"],
        "root_has_files": ["metadata.json"]
      },
      "source": {
        "type": "package_root",
        "preserve_candidate_dir": true
      },
      "target": {
        "path": "${palschema_mods_dir}",
        "type": "game_relative"
      },
      "description": "根目录命中 pals 目录时，识别为 PalSchema 数据扩展模组。",
      "post_install": [
        { "path": "${palschema_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "pal_schema_submod_payload_translations",
      "name": "PalSchema 数据扩展模组（translations）",
      "priority": 592,
      "match": {
        "root_has_dirs": ["translations"],
        "root_has_files": ["metadata.json"]
      },
      "source": {
        "type": "package_root",
        "preserve_candidate_dir": true
      },
      "target": {
        "path": "${palschema_mods_dir}",
        "type": "game_relative"
      },
      "description": "根目录命中 translations 目录时，识别为 PalSchema 数据扩展模组。",
      "post_install": [
        { "path": "${palschema_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "pal_schema_submod_payload_items",
      "name": "PalSchema 数据扩展模组（items）",
      "priority": 591,
      "match": {
        "root_has_dirs": ["items"],
        "root_has_files": ["metadata.json"]
      },
      "source": {
        "type": "package_root",
        "preserve_candidate_dir": true
      },
      "target": {
        "path": "${palschema_mods_dir}",
        "type": "game_relative"
      },
      "description": "根目录命中 items 目录时，识别为 PalSchema 数据扩展模组。",
      "post_install": [
        { "path": "${palschema_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "ue4ss_lua_script_mod_upper",
      "name": "UE4SS Lua脚本模组（Scripts/main.lua）",
      "priority": 590,
      "match": {
        "any_file_patterns": ["**/Scripts/main.lua"]
      },
      "source": {
        "type": "folder_containing",
        "marker": "Scripts"
      },
      "target": {
        "path": "${ue4ss_mods_dir}",
        "type": "game_relative"
      },
      "description": "根据 Scripts/main.lua 识别 UE4SS Lua 脚本模组。",
      "post_install": [
        { "path": "${ue4ss_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "ue4ss_lua_script_mod_lower",
      "name": "UE4SS Lua脚本模组（scripts/main.lua）",
      "priority": 589,
      "match": {
        "any_file_patterns": ["**/scripts/main.lua"]
      },
      "source": {
        "type": "folder_containing",
        "marker": "scripts"
      },
      "target": {
        "path": "${ue4ss_mods_dir}",
        "type": "game_relative"
      },
      "description": "根据 scripts/main.lua 识别 UE4SS Lua 脚本模组。",
      "post_install": [
        { "path": "${ue4ss_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "ue4ss_dll_script_mod",
      "name": "UE4SS DLL模组（dlls/main.dll）",
      "priority": 585,
      "match": {
        "any_file_patterns": ["**/dlls/main.dll"]
      },
      "source": {
        "type": "folder_containing",
        "marker": "dlls"
      },
      "target": {
        "path": "${ue4ss_mods_dir}",
        "type": "game_relative"
      },
      "description": "根据 dlls/main.dll 识别 UE4SS DLL 文件夹模组。",
      "post_install": [
        { "path": "${ue4ss_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "ue4ss_enabled_fallback",
      "name": "UE4SS 模组兜底（enabled.txt）",
      "priority": 580,
      "match": {
        "any_file_patterns": ["**/enabled.txt"]
      },
      "source": {
        "type": "folder_containing",
        "marker": "enabled.txt"
      },
      "target": {
        "path": "${ue4ss_mods_dir}",
        "type": "game_relative"
      },
      "description": "根据 enabled.txt 兜底识别 UE4SS 文件夹模组。",
      "post_install": [
        { "path": "${ue4ss_mods_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "ue_config_ini_mod",
      "name": "Unreal Engine 配置文件模组",
      "priority": 520,
      "match": {
        "any_root_files": [
          "Engine.ini",
          "Game.ini",
          "Input.ini",
          "Scalability.ini",
          "GameUserSettings.ini"
        ],
        "none_file_extensions": [".exe", ".dll", ".pak", ".ucas", ".utoc"]
      },
      "source": {
        "type": "package_root",
        "unwrap_single_root": true
      },
      "target": {
        "path": "${user_config_dir}",
        "type": "user_relative",
        "base_type": "local_appdata"
      },
      "description": "识别 Unreal Engine 配置文件类模组并安装到用户配置目录。"
    },
    {
      "id": "logicmods_folder_payload",
      "name": "LogicMods 文件夹模组",
      "priority": 519,
      "match": {
        "root_has_dirs": ["LogicMods"]
      },
      "source": {
        "type": "package_root"
      },
      "target": {
        "path": "${paks_dir}",
        "type": "game_relative"
      },
      "description": "根目录包含 LogicMods 文件夹时，保留该文件夹并安装到 Content\\Paks。",
      "post_install": [
        { "path": "${paks_dir}", "action": "ensure_dir_exists" }
      ]
    },
    {
      "id": "pak_mod_auto",
      "name": "基础Pak模组",
      "priority": 500,
      "match": {
        "any_file_extensions": [".pak"]
      },
      "source": {
        "type": "file_by_extension",
        "extension": ".pak"
      },
      "target": {
        "path": "${pak_mods_dir}",
        "type": "game_relative"
      },
      "description": "通用的 .pak 文件检测，作为 fallback 方案。",
      "post_install": [
        { "path": "${pak_mods_dir}", "action": "ensure_dir_exists" }
      ]
    }
  ]
}
